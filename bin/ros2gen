#!/bin/bash

VERSION="__ROS2GEN_VERSION__"

if [ "$VERSION" = "__ROS2GEN_VERSION__" ]; then
    VERSION=$(git describe --tags --always 2>/dev/null || echo "dev-build")
fi

show_help() {
  echo "Usage: ros2gen <robot_name> [options]"
  echo "Options:"
  echo "  -h, --help    Show this help message and exit"
  echo "  -v, --version Show version information and exit"
  echo "  -b, --basic   Generate basic packages (description, hardware, bringup)"
  echo "  --description Generate ONLY description package"
  echo "  --hardware    Generate ONLY hardware package"
  echo "  --bringup     Generate ONLY bringup package"
  echo "  --interfaces  Generate ONLY interfaces package (msg/srv/action)"
  echo "  --vision      Generate ONLY vision package"
  echo "  --simulation  Generate ONLY simulation package"
  echo "  --full        Generate ALL packages"
  echo "  -u, --update  Update ros2gen CLI to latest version"
}

# --- Fitur Self-Update ---
if [ "$1" == "--update" ] || [ "$1" == "-u" ]; then
  echo "Checking for updates and updating ros2gen..."
  curl -fsSL https://raw.githubusercontent.com/ahmdmarzuki/ros2gen/main/install.sh | bash
  exit 0
fi

if [ -d "/usr/local/share/ros2gen" ]; then
  ROS2GEN_SHARE="/usr/local/share/ros2gen"
else
  ROS2GEN_SHARE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

for pkg_script in "${ROS2GEN_SHARE}/lib/packages"/**/*.sh; do
  [ -f "$pkg_script" ] && source "$pkg_script"
done

source "${ROS2GEN_SHARE}/lib/interactive_menu.sh"

ANY_FLAG_SET=false

while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help)
      show_help
      exit 0
      ;;
    -v|--version)
      echo "ros2gen version $VERSION"
      exit 0
      ;;
    -b|--basic)
      DO_DESC=true
      DO_HW=true
      DO_BRINGUP=true
      ANY_FLAG_SET=true
      shift
      ;;
    --description)
      DO_DESC=true
      ANY_FLAG_SET=true
      shift
      ;;
    --hardware)
      DO_HW=true
      ANY_FLAG_SET=true
      shift
      ;;
    --bringup)
      DO_BRINGUP=true
      ANY_FLAG_SET=true
      shift
      ;;
    --interfaces)
      DO_INTERFACES=true
      ANY_FLAG_SET=true
      shift
      ;;
    --vision)
      DO_VISION=true
      ANY_FLAG_SET=true
      shift
      ;;
    --simulation)
      DO_SIMULATION=true
      ANY_FLAG_SET=true
      shift
      ;;
    --full)
      DO_DESC=true
      DO_HW=true
      DO_BRINGUP=true
      DO_INTERFACES=true
      DO_VISION=true
      DO_SIMULATION=true
      ANY_FLAG_SET=true
      shift
      ;;
    -*)
      echo "Unknown option: $1"
      exit 1
      ;;
    *)
      ROBOT_NAME=$1
      shift
      ;;
  esac
done

if [ "$ANY_FLAG_SET" = false ]; then
  run_tree_menu 
fi