#!/bin/bash

VERSION="__ROS2GEN_VERSION__"

show_help() {
  echo "Usage: ros2gen <robot_name> [options]"
  echo "Options:"
  echo "  -h, --help    Show this help message and exit"
  echo "  -v, --version  Show version information and exit"
  echo "  -b, --basic   Generate basic packages (description, hardware, bringup)"
  echo "  --description Generate ONLY description package"
  echo "  --hardware    Generate ONLY hardware package"
  echo "  --bringup     Generate ONLY bringup package"
  echo "  --interfaces  Generate ONLY interfaces package (msg/srv/action)"
  echo "  --vision      Generate ONLY vision package"
  echo "  --simulation  Generate ONLY simulation package"
  echo "  --full        Generate ALL packages"
  echo "  --update      Update ros2gen CLI to latest version"
}

# --- Fitur Self-Update ---
if [ "$1" == "--update" ] || [ "$1" == "-u" ]; then
  echo "🔄 Checking for updates and updating ros2gen..."
  curl -fsSL https://raw.githubusercontent.com/ahmdmarzuki/ros2-pkg-generator/main/install.sh | bash
  exit 0
fi

if [ -d "/usr/local/share/ros2gen" ]; then
  ROS2GEN_SHARE="/usr/local/share/ros2gen"
else
  ROS2GEN_SHARE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

source "${ROS2GEN_SHARE}/lib/pkg_description.sh"
source "${ROS2GEN_SHARE}/lib/pkg_hardware.sh"
source "${ROS2GEN_SHARE}/lib/pkg_bringup.sh"
source "${ROS2GEN_SHARE}/lib/pkg_vision.sh"
source "${ROS2GEN_SHARE}/lib/pkg_interfaces.sh"
source "${ROS2GEN_SHARE}/lib/pkg_simulation.sh"

source "${ROS2GEN_SHARE}/lib/interactive_menu.sh"

ROBOT_NAME=""

DO_DESC=false
DO_HW=false
DO_BRINGUP=false
DO_INTERFACES=false
DO_VISION=false
DO_SIMULATION=false
ANY_FLAG_SET=false

while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help)
      show_help
      exit 0
      ;;
    -v|--version)
      echo "ros2gen version $VERSION"
      exit 0
      ;;
    -b|--basic)
      DO_DESC=true
      DO_HW=true
      DO_BRINGUP=true
      ANY_FLAG_SET=true
      shift
      ;;
    --description)
      DO_DESC=true
      ANY_FLAG_SET=true
      shift
      ;;
    --hardware)
      DO_HW=true
      ANY_FLAG_SET=true
      shift
      ;;
    --bringup)
      DO_BRINGUP=true
      ANY_FLAG_SET=true
      shift
      ;;
    --interfaces)
      DO_INTERFACES=true
      ANY_FLAG_SET=true
      shift
      ;;
    --vision)
      DO_VISION=true
      ANY_FLAG_SET=true
      shift
      ;;
    --simulation)
      DO_SIMULATION=true
      ANY_FLAG_SET=true
      shift
      ;;
    --full)
      DO_DESC=true
      DO_HW=true
      DO_BRINGUP=true
      DO_INTERFACES=true
      DO_VISION=true
      DO_SIMULATION=true
      ANY_FLAG_SET=true
      shift
      ;;
    -*)
      echo "❌ Unknown option: $1"
      exit 1
      ;;
    *)
      ROBOT_NAME=$1
      shift
      ;;
  esac
done

if [ -z "$ROBOT_NAME" ]; then
  show_help
  exit 1
fi

if [ "$ANY_FLAG_SET" = false ]; then
  OPTIONS=("description" "hardware" "bringup" "interfaces" "vision" "simulation")
  
  run_interactive_menu "Pilih paket ROS 2 yang ingin dibuat:" "${OPTIONS[@]}"

  if [ ${#INTERACTIVE_SELECTED[@]} -eq 0 ]; then
    echo "⚠️ Tidak ada paket yang dipilih. Membatalkan instalasi."
    exit 0
  fi
  
  echo "Paket yang dipilih: ${SELECTED_RESULT[*]}"
  
  # Set flag berdasarkan hasil interaktif
  for pkg in "${SELECTED_RESULT[@]}"; do
    case $pkg in
      description) DO_DESC=true ;;
      hardware)    DO_HW=true ;;
      bringup)     DO_BRINGUP=true ;;
      interfaces)  DO_INTERFACES=true ;;
      vision)      DO_VISION=true ;;
      simulation)  DO_SIMULATION=true ;;
    esac
  done
fi

echo "Scaffolding ROS 2 Packages for: ${ROBOT_NAME}..."

# GENERATOR BLOCKS --------------------

if [ "$DO_DESC" = true ]; then
  generate_description "$ROBOT_NAME"
fi

if [ "$DO_HW" = true ]; then
  generate_hardware "$ROBOT_NAME"
fi

if [ "$DO_BRINGUP" = true ]; then
  generate_bringup "$ROBOT_NAME"
fi

if [ "$DO_INTERFACES" = true ]; then
  generate_interfaces "$ROBOT_NAME"
fi

if [ "$DO_VISION" = true ]; then
  generate_vision "$ROBOT_NAME"
fi

if [ "$DO_SIMULATION" = true ]; then
  generate_simulation "$ROBOT_NAME"
fi

# FIX CMakeLists.txt (Memastikan ament_package ada di paling bawah)

for pkg in $(ls -d ${ROBOT_NAME}_*/ 2>/dev/null); do
  sed -i '/ament_package()/d' ${pkg}CMakeLists.txt
  echo "ament_package()" >> ${pkg}CMakeLists.txt
done

echo "✅ Done!"